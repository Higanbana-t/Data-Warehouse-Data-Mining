DEBEZIUM_VERSION=3.7
# Image tương thích S3. Image chính thức minio/minio (Docker Hub, Quay) đã bị gỡ; xem mục 14.13 của báo cáo.
S3_IMAGE=docker.io/pgsty/silo:RELEASE.2026-09-16T00-00-00Z

# ---------------- MySQL (CSDL nguồn) ----------------
MYSQL_ROOT_PASSWORD=doi_mat_khau_root_mysql
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=doi_mat_khau_debezium
SIMULATOR_PASSWORD=doi_mat_khau_simulator
MYSQL_HOST_PORT=3307

# ---------------- PostgreSQL (Data Warehouse) ----------------
POSTGRES_USER=dw_admin
POSTGRES_PASSWORD=doi_mat_khau_postgres
POSTGRES_DB=network_dw
PG_HOST_PORT=5433

# ---------------- Kafka / Debezium ----------------
# UUID dạng base64, 22 ký tự. Giá trị mẫu lấy từ tài liệu Debezium; nên tạo giá trị riêng của bạn.
KAFKA_CLUSTER_ID=oh-sxaDRTcyAr6pFRbXyzA
CONNECT_HOST_PORT=8083

# ---------------- Data Lake (S3) ----------------
# Tài khoản gốc của dịch vụ S3: tên >= 3 ký tự, mật khẩu >= 8 ký tự
S3_ACCESS_KEY=lakeadmin
S3_SECRET_KEY=doi_mat_khau_s3_dai
S3_BUCKET=network-lake
S3_API_HOST_PORT=19000
S3_CONSOLE_HOST_PORT=19001

# ---------------- Cho các script chạy TRÊN MÁY CHỦ (ngoài Docker): run_queries, train, notebook ----------------
# Trỏ vào PostgreSQL trong container qua cổng đã publish.
PGHOST=localhost
PGPORT=5433
PGDATABASE=network_dw
PGUSER=dw_admin
PGPASSWORD=doi_mat_khau_postgres

# ---------------- Firewall API và Collector ----------------
FIREWALL_API_KEY=doi_khoa_api_firewall
API_HOST_PORT=8000
REPLAY_RATE=0
MAX_REQUESTS_PER_SECOND=50
POLL_INTERVAL_SECONDS=0.5
BATCH_LIMIT=500
